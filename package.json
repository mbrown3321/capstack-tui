{
  "name": "screenshot-organizer",
  "version": "0.1.0",
  "description": "A TUI for organizing screenshots for tickets and PRs",
  "type": "module",
  "bin": {
    "capstack": "./src/cli.jsx"
  },
  "scripts": {
    "start": "tsx src/cli.jsx",
    "dev": "tsx watch src/cli.jsx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.2.0",
    "clipboardy": "^4.0.0",
    "chokidar": "^3.6.0",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "tsx": "^4.0.0",
    "vitest": "^1.0.0"
  },
  "vitest": {
    "include": ["tests/**/*.test.js"]
  }
}